# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Local development only. Sign-ins started on Vercel Preview are redirected to the stable production domain.
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
# Register https://wavelength-reproductor-musica.vercel.app/callback in the Spotify Developer Dashboard.

# YouTube Music API (optional - for MCP proxy)
YOUTUBE_API_KEY=your_youtube_api_key_here