# Spotify API Configuration
# Get these from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# For local development, use this loopback URL and register it in Spotify's Redirect URIs.
# Set VITE_SPOTIFY_REDIRECT_URI to your production callback URL in Vercel.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
# Production: https://wavelength-reproductor-musica.vercel.app/callback
# Set VITE_SPOTIFY_CLIENT_ID and VITE_SPOTIFY_REDIRECT_URI in Vercel, then redeploy.

# YouTube Music API (server only)
# Enable YouTube Data API v3 and create a Google Cloud OAuth client for TVs and Limited Input devices.
# Set these in Vercel Project Settings and in a local .env file for `vercel dev`.
YTMUSIC_CLIENT_ID=your_google_oauth_client_id
YTMUSIC_CLIENT_SECRET=your_google_oauth_client_secret
# Generate with: openssl rand -hex 32
YTMUSIC_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
